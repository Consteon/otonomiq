# Fastfile for Otonomiq & Frontez Engine Brands
default_platform(:ios)

platform :ios do
  desc "Build IPA and upload to App Store Connect / TestFlight"
  lane :beta do
    sh("security unlock-keychain -p '' ~/Library/Keychains/login.keychain-db 2>/dev/null || security unlock-keychain -p '' ~/Library/Keychains/login.keychain 2>/dev/null || true")
    sh("xattr -cr .. 2>/dev/null || true")
    # Locate any AuthKey_*.p8 file in ~/.credentials, fastlane directory, ios directory, or unique directory
    p8_files = Dir[File.expand_path("~/.credentials/AuthKey_*.p8")] + Dir["fastlane/AuthKey_*.p8"] + Dir["AuthKey_*.p8"] + Dir["../../unique/*/ios/AuthKey_*.p8"] + Dir["../../unique/autsorz/ios/AuthKey_*.p8"]
    p8_file = p8_files.first ? File.expand_path(p8_files.first) : nil
    key_id = p8_file ? File.basename(p8_file, ".p8").sub("AuthKey_", "") : nil
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"] || "37e3df4e-280e-4b95-bd06-5d1f88da7828"
    api_key = nil

    if p8_file && File.exist?(p8_file)
      UI.message("Authenticating with App Store Connect API Key: #{key_id} (file: #{p8_file})")
      api_key = app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_filepath: p8_file
      )
    end

    # Pre-fetch or generate App Store Provisioning Profile & Certificates via Fastlane
    app_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    team_id = CredentialsManager::AppfileConfig.try_fetch_value(:team_id) || "8376259CR4"
    if p8_file && File.exist?(p8_file) && app_id
      begin
        require "json"
        key_json_path = "/tmp/app_store_connect_key.json"
        File.write(key_json_path, JSON.dump({
          key_id: key_id,
          issuer_id: issuer_id,
          key: File.read(p8_file),
          duration: 1200,
          in_house: false
        }))
        
        # Ensure Apple Distribution certificate is present in Keychain
        begin
          get_certificates(
            api_key_path: key_json_path,
            team_id: team_id
          )
        rescue => cert_err
          UI.important("Certificate check notice: #{cert_err.message}")
        end

        UI.message("Syncing App Store Provisioning Profile for #{app_id} (Team: #{team_id})...")
        get_provisioning_profile(
          api_key_path: key_json_path,
          app_identifier: app_id,
          team_id: team_id
        )
      rescue => e
        UI.important("Provisioning profile pre-fetch notice: #{e.message}. Proceeding to build...")
      end
    end

    # Build the iOS archive via Flutter
    sh("unset GEM_HOME GEM_PATH RUBYLIB; cd .. && flutter build ipa --release || true")
    
    # Resolve real path of the flutter build directory to handle symlinks like /tmp/<app>_build
    possible_build_dirs = ["../../build", "../build", "build"].select { |p| File.exist?(p) }.map { |p| File.realpath(p) }
    ipa_path = possible_build_dirs.map { |d| Dir["#{d}/ios/ipa/*.ipa"].first }.compact.first
    
    # If no IPA was produced by flutter build ipa (e.g. xcodebuild -exportArchive failed due to missing Xcode GUI accounts),
    # export the generated archive using xcodebuild with the local Distribution Certificate & Provisioning Profile!
    if (ipa_path.nil? || !File.exist?(ipa_path))
      archive_path = possible_build_dirs.map { |d| Dir["#{d}/ios/archive/Runner.xcarchive"].first }.compact.first
      if archive_path && File.exist?(archive_path)
        UI.message("📦 Runner.xcarchive found at #{archive_path}. Exporting IPA with local Distribution Signing...")
        
        real_build_dir = File.dirname(File.dirname(archive_path))
        export_dir = "#{real_build_dir}/ios/ipa"
        FileUtils.mkdir_p(export_dir)
        
        profile_name = ENV["sigh_#{app_id}_appstore_profile-name"] || "#{app_id} AppStore"
        export_plist_path = "/tmp/ExportOptions_AppStore.plist"
        File.write(export_plist_path, <<~PLIST)
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
          <plist version="1.0">
          <dict>
              <key>destination</key>
              <string>export</string>
              <key>manageAppVersionAndBuildNumber</key>
              <true/>
              <key>method</key>
              <string>app-store</string>
              <key>signingStyle</key>
              <string>manual</string>
              <key>teamID</key>
              <string>#{team_id}</string>
              <key>provisioningProfiles</key>
              <dict>
                  <key>#{app_id}</key>
                  <string>#{profile_name}</string>
              </dict>
              <key>stripSwiftSymbols</key>
              <true/>
              <key>uploadSymbols</key>
              <true/>
          </dict>
          </plist>
        PLIST

        export_cmd = [
          "xcodebuild",
          "-exportArchive",
          "-archivePath", "\"#{archive_path}\"",
          "-exportPath", "\"#{export_dir}\"",
          "-exportOptionsPlist", "\"#{export_plist_path}\""
        ].join(" ")

        UI.message("Executing: #{export_cmd}")
        sh(export_cmd)

        ipa_path = Dir["#{export_dir}/*.ipa"].first
      end
    end

    UI.message("Found IPA file: #{ipa_path}")
    
    if ipa_path.nil? || !File.exist?(ipa_path)
      UI.user_error!("❌ No .ipa file found in build output directories. The archive was created, but Xcode could not export the IPA.")
    end
    
    if api_key
      upload_to_testflight(
        api_key: api_key,
        ipa: ipa_path,
        skip_waiting_for_build_processing: true
      )
    else
      upload_to_testflight(
        ipa: ipa_path,
        skip_waiting_for_build_processing: true
      )
    end
  end

  desc "Build IPA locally without uploading"
  lane :build do
    sh("xattr -cr .. 2>/dev/null || true")
    sh("unset GEM_HOME GEM_PATH RUBYLIB; cd .. && flutter build ipa --release")
  end
end
