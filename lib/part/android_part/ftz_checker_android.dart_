/*
  221111 [HH]
  attendance widget. Display widget for qr scan and/or photo/selfie. Get gps
    location, internet status, time from gps / ntp server
  component:
    type : location
    opMode :
      qr
      qr-photo
      photo-with-qr
      face-recognition
    url : image url
    width : displayed image (from url) width (height will be calculated)
    text : display/dialog text, diamond separated
    route : next route
    flag : flag to be written in output
    imHeight : stored acquired image height (pixels)
    imWidth : stored acquired image width (pixels)
    folder : folder in Google Cloud storage to store acquired image
    filename : acquired image name (without .png)
    displayMode : single (default) | multi
    lqr : default 0 = checker no need to scan lqr | 1 =  need to scan lqr
    duration : default 5 minutes, duration of lqr. after this, checker need to scan lqr again

  primitives:
    takePicture(lens)
    takeQr
    getLocationData
    lqrVerify
    attendanceDialog(type)
    saveData : save aquired data to firebase => proxy event
    getVidList : get eligible checkee vid put in vidList
    checkVid
*/
class Controller extends GetxController {
  var count = 10.obs;
  var message = ''.obs;
  decrease() => count--;
}

class FtzChecker extends StatefulWidget {
  const FtzChecker({
    required Key key,
    required this.component,
    required this.scrName,
    required this.single,
  }) : super(key: key);
  final String scrName;
  final dynamic component;
  final bool single;

  @override
  FtzCheckerState createState() => FtzCheckerState();
}

class FtzCheckerState extends State<FtzChecker> {
  bool change = true;
  final controller = TextEditingController(text: '-');
  bool tapped = false;
  Position? position;
  List<Placemark> placeMark = [];
  int? lastPositionTime;
  int timeDiff = 0;
  List<String> checkerHistory = [];
  double h = 0.0;
  double w = 0.0;
  List<dynamic> textArray = [];
  int lastSave = 0;
  int saveDelay = 10000;

  @override
  void initState() {
    super.initState();
    // getCurrentPosition(desiredAccuracy: LocationAccuracy.high),
    if (widget.component['table'] != null) {
      subscribeToTable(widget.component['table']);
      // todo unsubscribe at dispose if desirable (will be need to load again)
    } // end if (widget.component['table'] != null)
    timeDiff = transactionStore.state.screenTx['#REF_TIME_START'] -
        transactionStore.state.screenTx['#DEVICE_TIME_START'];
    getLocation().then((pos) {
      lastPositionTime = DateTime.now().millisecondsSinceEpoch;
      position = pos;
      placemarkFromCoordinates(position!.latitude, position!.longitude)
          .then((pm) {
        placeMark = pm;
      }); // end of placemarkFromCoordinates
    });
    textArray = diamondTextToList(widget.component['text']);
  } // end of initState

  @override
  Widget build(BuildContext context) {
    String selfieUrl = '';

