    Future<String?> checkerDialog(
        {String title = '',
        String message = '',
        String okString = 'Ok'}) async {
      return Get.dialog(AlertDialog(
        // dialog 3
        // title: Text(title),
        content: Container(
          alignment: const Alignment(0.0, 0.0),
          height: dialogHeight,
          child: Column(
            mainAxisSize: MainAxisSize.min,
            mainAxisAlignment: MainAxisAlignment.start,
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(message),
            ],
          ),
        ),
        actions: <Widget>[
          TextButton(
            child: Text(okString),
            onPressed: () {
              routeStack.pop();
              Get.back();
            },
          ),
        ],
      ));
    } // end of checkerDialog

    Future<String?> checkerSendDialog(
        {String title = '',
        String message1 = '',
        String message2 = '',
        int counter = 10,
        String okString = 'Ok'}) async {
      var getController = Get.put(Controller());
      //getController.decrease();
      getController.count.value = counter;
      getController.message.value = counter <= 0 ? message2 : message1;
      Stream timer = Stream.periodic(const Duration(seconds: 1), (_) {
        int current = DateTime.now().millisecondsSinceEpoch;
        return current;
      });
      StreamSubscription timerSubscription = timer.listen((data) {
        if (getController.count.value == 0) {
          getController.message.value = message2;
        } else if (getController.count.value > 0) {
          getController.decrease();
        } // end if (c-- <=0)
      }); // end timer subscription
      return Get.dialog(AlertDialog(
        // dialog 3
        // title: Text(title),
        content: Container(
          alignment: const Alignment(0.0, 0.0),
          height: dialogHeight,
          child: Obx(
            () => Column(
              mainAxisSize: MainAxisSize.min,
              mainAxisAlignment: MainAxisAlignment.start,
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Center(child: Text("${getController.message}")),
                Container(),
                Center(
                    child: Text(
                  "${(getController.count.value > 0) ? getController.count : ''}",
                  style: const TextStyle(
                      fontWeight: FontWeight.bold, fontSize: 16),
                )),
              ],
            ),
          ),
        ),
        actions: <Widget>[
          Obx(
            () => getController.count.value > 0
                ? Container()
                : TextButton(
                    child: Text(okString),
                    onPressed: () {
                      //getController.decrease();
                      setDataOK('2'); // display green
                      timerSubscription.cancel();
                      routeStack.pop();
                      Get.back();
                    },
                  ),
          )
        ],
      ));
    } // end of checkerSendDialog

    List? checkerVerifyVid(int vid, String tableCode) {
      // List? result = findData(tableCode, '79713766773060');
      List? result = findData(tableCode, vid.toString());
      if (result != null) {
        result[0] = int.parse(result[0]);
      }
      return result;
    } // end of checkerVerifyVid

    Future<String?> checkerTakeQR(String label, String scrName, var component,
        String caller, String lens) async {
