        content: SizedBox(
          height: h - 20,
          width: w - 20,
          child: FtzMobileScanner(
            screenName: scrName,
            component: component,
            caller: caller,
            tried: 0,
            result: qrResult,
            buttonConfiguration: 'checker1',
            buttonString: textArray[2],
            lens: lens,
          ),
